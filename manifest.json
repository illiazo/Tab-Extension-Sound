{
  "manifest_version": 3,
  "name": "Tab Sound",
  "version": "1.0.0",
  "description": "Play custom sounds when tabs open and close. Customize your browsing experience with audio notifications.",
  "author": "Illiazo",
  "homepage_url": "https://github.com/yourusername/tab-sound-extension",
  "permissions": ["tabs", "storage", "offscreen"],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Tab Sound Options",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
